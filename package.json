{
  "name": "pii-detector",
  "version": "0.1.0",
  "private": true,
  "description": "PoC: detect PII in web-application logs with TypeSafe Jev noul questions",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "detect": "tsx src/cli.ts",
    "test": "vitest run",
